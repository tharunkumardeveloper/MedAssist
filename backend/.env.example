SECRET_KEY=replace-with-output-of-python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./medassist.db
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Creates one admin account on first startup if no admin exists yet. Leave unset to skip.
BOOTSTRAP_ADMIN_EMAIL=admin@medassist.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
