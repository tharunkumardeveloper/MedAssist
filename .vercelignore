# Vercel Ignore File - Excludes files from deployment

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
ENV/
.venv

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development databases
*.db
*.sqlite
*.sqlite3
backend/medassist.db

# Environment files (secrets managed by Vercel)
.env
.env.local
.env.*.local
backend/.env
web/.env

# Generated reports
backend/generated_reports/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore

# Documentation (not needed in deployment)
*.md
!README.md
SETUP.md
CONTRIBUTING.md
QUICKSTART.md
DEPLOYMENT_SUMMARY.md

# Tests
backend/tests/
**/tests/
**/__tests__/
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Docker (not used in Vercel)
Dockerfile
docker-compose.yml
.dockerignore

# Legacy frontend
frontend/

# Setup scripts (not needed in deployment)
setup.ps1
setup.bat
start.ps1
start.bat
verify-installation.ps1

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp
